+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""
+Diagnose whether a generated dialogues CSV has mojibake ("â€"-style
+corruption) baked into it, or whether it's clean and any corruption you've
+seen came from how it was opened afterward (e.g. editing in Notepad before
+opening in Excel, which can silently strip the UTF-8 BOM that
+generator.py's atomic_to_csv(..., encoding="utf-8-sig") writes).
+
+Usage:
+    python diagnose_csv_encoding.py path/to/dialogues.csv
+
+What it does, in order:
+  1. Checks whether the file starts with a UTF-8 BOM (EF BB BF) -- this is
+     what generator.py writes; its ABSENCE means either an older run, or
+     something downstream (e.g. Notepad's "save") stripped it.
+  2. Reads the file with pandas (encoding='utf-8-sig', matching what
+     generator.py itself uses to read this exact file back in for
+     --resume) and scans every string cell for common mojibake signatures
+     -- not just "â€", but the broader family of UTF-8-decoded-as-
+     cp1252/latin-1 patterns.
+  3. Reports which columns and how many cells are affected, with a few
+     concrete examples, so you can see the actual damage rather than a
+     bare count.
+
+If step 2 finds mojibake in a CSV you have NOT touched since it was
+written by generate (no Notepad edit, no Excel resave), that means the
+corruption is upstream of the write -- in the API response content
+itself, before it ever reaches this script -- and the fix path is
+different (see the write-up in chat, not this script) from if the file
+comes back clean here and only breaks after your usual open-and-edit
+workflow.
+"""
+
+import argparse
+import re
+import sys
+from collections import Counter
+
+import pandas as pd
+
+# Cheap, well-known signatures of "UTF-8 bytes decoded as cp1252/latin-1".
+# Not exhaustive -- there's no way to be, since any byte sequence CAN
+# coincidentally look like real text -- but these cover the overwhelming
+# majority of real-world English-text mojibake, including exactly the
+# "â€"-family patterns from curly quotes/em dashes/accented letters.
+#
+# cp1252 remaps bytes 0x80-0x9F to a scattered set of punctuation/symbol
+# codepoints (NOT their raw Unicode C1-control equivalents -- 0x99 becomes
+# U+2122 "TM", not U+0099 -- that's the one mistake worth flagging if
+# you're ever hand-editing this list yourself), which is exactly the
+# range UTF-8's own continuation bytes for common punctuation (curly
+# quotes, dashes, ellipsis, bullet -- all in the U+2000 block, encoded as
+# 0xE2 0x80/0x81 0xXX) fall into. Built from the real cp1252 table rather
+# than hand-typed so it can't silently drift from what Python actually
+# does.
+def _cp1252_c1_remap_chars() -> str:
+    chars = []
+    for byte_value in range(0x80, 0xA0):
+        try:
+            chars.append(bytes([byte_value]).decode("cp1252"))
+        except UnicodeDecodeError:
+            pass  # a handful of 0x80-0x9F bytes are simply undefined in cp1252
+    return "".join(chars)
+
+
+_CP1252_C1_REMAP = re.escape(_cp1252_c1_remap_chars())
+_CONTINUATION_BYTE_CHARS = _CP1252_C1_REMAP + r"\u00a0-\u00bf"
+
+MOJIBAKE_PATTERNS = [
+    rf"\u00e2[{_CONTINUATION_BYTE_CHARS}][{_CONTINUATION_BYTE_CHARS}]",  # â + 2 more decoded continuation bytes, e.g. â€™ â€” â€œ
+    r"\u00c3[\u0080-\u00bf]",  # Ã© Ã¨ Ã¼ Ã¶ Ã± etc (accented Latin-1 letters)
+    r"\u00c2[\u00a0-\u00bf]",  # Â  Â£ Â© etc (Latin-1 Supplement control/symbol block)
+    r"\ufffd",  # literal replacement character -- unrecoverable loss, not just mojibake
+]
+MOJIBAKE_RE = re.compile("|".join(MOJIBAKE_PATTERNS))
+
+
+def check_bom(path: str) -> bool:
+    with open(path, "rb") as f:
+        head = f.read(3)
+    return head == b"\xef\xbb\xbf"
+
+
+def scan_dataframe(df: "pd.DataFrame"):
+    """Returns (total_flagged_cells, {column: count}, [(column, row, snippet), ...])"""
+    per_column: Counter = Counter()
+    examples = []
+    total = 0
+    for col in df.columns:
+        # NOTE: don't compare dtype == object directly -- pandas 3.0's
+        # read_csv returns a native 'str' dtype for text columns, not the
+        # legacy 'object' dtype older pandas used, so a bare "!= object"
+        # check silently skips every text column on pandas 3.0+ (caught
+        # this by actually running the script against a synthetic
+        # corrupted file, not just reading the code -- it reported 0
+        # matches on a file with a dozen deliberately-planted ones).
+        if not (pd.api.types.is_object_dtype(df[col]) or pd.api.types.is_string_dtype(df[col])):
+            continue
+        for row_idx, value in df[col].items():
+            if not isinstance(value, str):
+                continue
+            match = MOJIBAKE_RE.search(value)
+            if match:
+                total += 1
+                per_column[col] += 1
+                if len(examples) < 20:
+                    start = max(match.start() - 20, 0)
+                    end = min(match.end() + 20, len(value))
+                    snippet = value[start:end]
+                    examples.append((col, row_idx, snippet))
+    return total, per_column, examples
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("csv_path", help="Path to the dialogues CSV to check")
+    args = parser.parse_args()
+
+    print(f"Checking {args.csv_path} ...\n")
+
+    has_bom = check_bom(args.csv_path)
+    print(f"UTF-8 BOM present at file start: {has_bom}")
+    if not has_bom:
+        print(
+            "  -> No BOM. If this file came straight from generate (never "
+            "opened/saved in Notepad or Excel), that means either it "
+            "predates the utf-8-sig fix in generator.py, or something "
+            "wrote/rewrote it without one. If it HAS been through "
+            "Notepad, this is consistent with Notepad's save step "
+            "stripping the BOM -- re-check on a copy you haven't edited."
+        )
+    print()
+
+    try:
+        df = pd.read_csv(args.csv_path, encoding="utf-8-sig")
+    except UnicodeDecodeError as e:
+        print(f"FAILED to read as UTF-8 at all: {e}")
+        print(
+            "This is a stronger signal than mojibake -- the file isn't "
+            "valid UTF-8 as-is, meaning some byte-level corruption (not "
+            "just a wrong-codepage re-interpretation) happened somewhere "
+            "in the write/edit chain."
+        )
+        sys.exit(1)
+
+    total, per_column, examples = scan_dataframe(df)
+
+    print(f"Cells matching a known mojibake pattern: {total}")
+    if total:
+        print("By column:")
+        for col, count in per_column.most_common():
+            print(f"  {col}: {count}")
+        print("\nExample snippets (column, row, ~40 chars around the match):")
+        for col, row_idx, snippet in examples:
+            print(f"  [{col}, row {row_idx}] ...{snippet!r}...")
+        print(
+            "\nThis file (as read here, via the same encoding="
+            "'utf-8-sig' generator.py itself uses) already contains "
+            "mojibake -- the corruption is IN THE DATA, not just how a "
+            "later viewer (Excel/Notepad) rendered it. That points "
+            "upstream of the CSV write: worth capturing one raw API "
+            "response for an affected row (log payload['messages']/"
+            "response content before it's written to the DataFrame) to "
+            "see whether the mojibake is already present in what the "
+            "provider returned."
+        )
+    else:
+        print(
+            "\nNo mojibake found when read directly with pandas. If "
+            "you've seen 'â€'-style corruption when opening this exact "
+            "file, it's most likely being introduced AFTER this script's "
+            "read -- e.g. by editing it in Notepad (which can save "
+            "without preserving the UTF-8 BOM) before opening in Excel. "
+            "Try opening the file directly in Excel via Data > Get Data > "
+            "From Text/CSV with 'File Origin' explicitly set to "
+            "'65001: Unicode (UTF-8)', or just double-click the CSV "
+            "(the BOM should make Excel auto-detect UTF-8 without needing "
+            "the 'sep=,' trick) instead of editing it in Notepad first."
+        )
+
+
+if __name__ == "__main__":
+    main()
